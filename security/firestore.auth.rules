rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function member(c) { return get(/databases/$(database)/documents/authz/$(request.auth.uid)/companies/$(c)).data; }
    function companyActive(c) { return get(/databases/$(database)/documents/companies/$(c)).data.status == 'active'; }
    function active(c) { return verified() && companyActive(c) && member(c).status == 'active' && member(c).companyId == c; }
    function admin(c) { return active(c) && member(c).role == 'tenant_admin'; }
    function staff(c) { return active(c) && member(c).role in ['tenant_admin','tenant_staff']; }
    function can(c,p) { return admin(c) || (staff(c) && member(c).permissions.get(p,false) == true); }
    function noSecrets(d) { return !d.keys().hasAny(['password','password2','password3','pwd','token','credentials']); }
    // All approval, identity, platform and audit documents are server-only.
    match /authz/{path=**} { allow read, write: if false; }
    match /identityBindings/{path=**} { allow read, write: if false; }
    match /platformAccess/{path=**} { allow read, write: if false; }
    match /authAudit/{path=**} { allow read, write: if false; }
    match /signupRequests/{path=**} { allow read, write: if false; }
    match /companies/{c} {
      allow get: if staff(c) && noSecrets(resource.data);
      allow list, create, delete: if false;
      allow update: if admin(c) && noSecrets(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','address','phone','managerContact','updatedAt']);
      match /staffList/{d} {
        allow read: if staff(c) && noSecrets(resource.data);
        allow write: if false; // Server approval/profile endpoint required; no client role edits.
      }
      match /partners/{d} {
        allow read: if staff(c) && noSecrets(resource.data);
        allow write: if false; // Legacy contact passwords require separately approved cleanup.
      }
      match /salesOrders/{d} {
        allow read: if can(c,'orders');
        allow create, update: if can(c,'orders') && noSecrets(request.resource.data) && request.resource.data.companyId == c;
        allow delete: if can(c,'orders');
      }
      // Dedicated, safe projection for partner ordering. Never expose staff/company bundles.
      match /partnerOrders/{d} {
        function own(data) { return active(c) && member(c).role == 'partner' && data.partnerId == member(c).partnerId && data.companyId == c; }
        allow read: if can(c,'orders') || own(resource.data);
        allow create: if (can(c,'orders') || own(request.resource.data)) && request.resource.data.keys().hasOnly(['companyId','partnerId','items','note','status','createdAt']) && request.resource.data.status == 'submitted';
        allow update, delete: if false;
      }
      match /settings/{d} {
        allow read: if d in ['inventory','physicalInventory'] && can(c,'inventory');
        allow create, update: if d in ['inventory','physicalInventory'] && can(c,'inventory') && noSecrets(request.resource.data);
        allow delete: if false;
      }
      match /{col}/{d} {
        // Explicit allowlist. No blanket grant to every authenticated company user.
        function permission() {
          return col in ['inventory','physicalInventory','inventoryAdjustments','inventoryTransferHistory'] ? 'inventory' :
            col in ['loadingEvents','loadingLists'] ? 'loading' :
            col in ['deliveries','deliveryHistory'] ? 'delivery' :
            col in ['salesInvoices','purchaseInvoices','depositSlips','withdrawalSlips'] ? 'invoices' :
            col in ['products','categories','warehouses','accounts','specialPrices'] ? 'catalog' :
            col in ['salesReports','purchaseReports'] ? 'reports' : 'DENY';
        }
        allow read: if permission() != 'DENY' && can(c,permission());
        allow create, update: if permission() != 'DENY' && can(c,permission()) && noSecrets(request.resource.data);
        allow delete: if permission() != 'DENY' && can(c,permission());
      }
      // Bundles/metadata denied until per-bundle permission mapping and secret cleanup verified.
    }
    match /{path=**} { allow read, write: if false; }
  }
}
